# Supabase Transaction pooler URL for the deployed app. Use port 6543.
# Add ?pgbouncer=true&connection_limit=1 when using the transaction pooler.
DATABASE_URL="postgresql://prisma.PROJECT_REF:YOUR_PRISMA_PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase Session pooler or Direct URL for Prisma migrations. Session pooler uses port 5432.
DIRECT_URL="postgresql://prisma.PROJECT_REF:YOUR_PRISMA_PASSWORD@POOLER_HOST:5432/postgres"

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
AUTH_SECRET="GENERATE_A_LONG_RANDOM_SECRET"
AUTH_URL="http://localhost:3000"
